# Supabase-project (Settings -> API in het Supabase-dashboard)
# Gebruik een EU-regio (bv. Frankfurt) voor GDPR-compliance.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key - enkel server-side gebruikt (GDPR-verwijdering van accounts).
# NOOIT naar de client sturen of committen.
SUPABASE_SERVICE_ROLE_KEY=

# Basis-URL van de app (redirect-links in uitnodigings-/wachtwoord-e-mails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Wix Bookings - workshopkalender van de website in de app tonen (server-side).
# Account-level API key met leesrechten voor Wix Bookings. Zonder key wordt
# de workshop-sectie gewoon niet getoond.
WIX_API_KEY=
WIX_SITE_ID=f94fbe0f-3877-4be8-9c14-d13a44537e9b

# Dagelijkse backup-mail via SMTP (Google Workspace). Zonder deze vars wordt
# de back-up wel gemaakt en opgeslagen, maar niet gemaild.
# SMTP_PASS = een Google "app-wachtwoord" (Account -> Beveiliging -> App-wachtwoorden),
# niet het gewone wachtwoord. 2FA moet aanstaan op dat account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
BACKUP_EMAIL_TO=
# Optioneel, standaard = SMTP_USER
BACKUP_EMAIL_FROM=

# Cron-secret: Vercel stuurt dit mee bij de dagelijkse /api/backup/generate.
CRON_SECRET=

# Fase 2 (nog niet gebruikt) - Odoo Online koppeling
ODOO_URL=
ODOO_DB=
ODOO_API_KEY=
